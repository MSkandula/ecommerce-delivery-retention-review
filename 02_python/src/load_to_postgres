"""
load_to_postgres.py
Loads the 9 raw Olist tables into Postgres as a `raw` schema.
Cleaning, standardising and the business-question queries happen in SQL
from here on — this script's only job is getting the data in, typed correctly.
"""

import pandas as pd
from sqlalchemy import text
from load_data import load_all_tables
from db import get_engine


def load_raw_tables():
    engine = get_engine()
    tables = load_all_tables()

    with engine.connect() as conn:
        conn.execute(text("CREATE SCHEMA IF NOT EXISTS raw"))
        conn.commit()

    # orders loads into the explicitly-typed table created by DDL — append, don't replace,
    # so pandas doesn't drop the table and re-infer types (that's what caused the text-column bug)
    orders_df = tables.pop("orders")
    orders_df["order_purchase_timestamp"] = pd.to_datetime(orders_df["order_purchase_timestamp"])
    orders_df["order_approved_at"] = pd.to_datetime(orders_df["order_approved_at"])
    orders_df["order_delivered_carrier_date"] = pd.to_datetime(orders_df["order_delivered_carrier_date"])
    orders_df["order_delivered_customer_date"] = pd.to_datetime(orders_df["order_delivered_customer_date"])
    orders_df["order_estimated_delivery_date"] = pd.to_datetime(orders_df["order_estimated_delivery_date"])
    orders_df.to_sql("orders", con=engine, schema="raw", if_exists="append", index=False)
    print(f"Loaded raw.orders (typed)      {len(orders_df):>8,} rows")

    # the other 8 tables have no date columns feeding the six business questions,
    # so type inference isn't a problem for them — replace is fine here
    for name, df in tables.items():
        df.to_sql(name, con=engine, schema="raw", if_exists="replace", index=False)
        print(f"Loaded raw.{name:22s} {len(df):>8,} rows")


if __name__ == "__main__":
    load_raw_tables()